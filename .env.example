# AgriLink Environment Configuration Example
# Copy this file to .env or configure your environment variables before production deployment.

# Environment mode: 'development' or 'production'
FLASK_ENV=development
AGRILINK_ENV=development

# Secret key for JWT and session encryption (REQUIRED in production).
# Generate a strong key in production, e.g., using: python -c "import secrets; print(secrets.token_hex(32))"
# Do NOT commit your production SECRET_KEY to version control.
SECRET_KEY=replace_with_a_secure_random_hex_key_in_production

# Dedicated maintenance API key for POST /api/admin/cleanup-sessions (REQUIRED for admin tasks in production).
ADMIN_API_KEY=replace_with_a_secure_random_admin_key_in_production

# Allowed CORS origins in production (comma-separated list).
# In production, requests from unlisted origins will be rejected.
CORS_ALLOWED_ORIGINS=https://agrilink.example.com,https://app.agrilink.example.com

# Trusted reverse proxies count (e.g. 1 if behind Nginx/ALB/Cloudflare, 0 if standalone)
# Enables Werkzeug ProxyFix to safely set client IP and prevent header spoofing.
NUM_PROXIES=0

# Rate Limiting Configuration (Persistent, backed by SQLite)
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=60
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW=60

# Optional: Custom database file path (e.g. if mounted on a persistent disk volume)
# Defaults to backend/data/agrilink.db
# DB_PATH=/var/data/agrilink.db

# Optional: Internal Flask API base URL for Streamlit
# Defaults to http://127.0.0.1:5000/api
# API_BASE_URL=http://127.0.0.1:5000/api
